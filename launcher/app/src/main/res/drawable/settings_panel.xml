<?xml version="1.0" encoding="utf-8"?>
<!-- The settings panel's own surface: nearly solid, with a hairline down its left edge against Home. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5101319" />
        </shape>
    </item>
    <item android:right="-2dp" android:top="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
