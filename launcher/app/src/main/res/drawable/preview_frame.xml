<?xml version="1.0" encoding="utf-8"?>
<!-- Input preview window: thin frame, bright white ring while focused. The video (a SurfaceView) cannot be
     clipped round, so the window keeps 7dp padding: its square corners then stay inside the 14dp radius. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <stroke android:width="3dp" android:color="#F5FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
