<?xml version="1.0" encoding="utf-8"?>
<!--
  A panel down the right-hand side, over Home, in the style of the TV's own settings: Home stays visible and
  dimmed on the left, so a change can be seen against the screen it changes. Every row the one-list version had is
  here, grouped under its section. The window itself is translucent (Theme.TvHome.Panel).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dims Home so the panel reads as being in front of it. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/settings_panel"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="30dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_settings"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                style="@style/SettingsHint"
                android:layout_marginTop="2dp"
                android:text="@string/settings_apply_hint" />

            <TextView style="@style/SettingsSection" android:text="@string/section_layout" />

            <TextView
                android:id="@+id/layoutChoice"
                style="@style/SettingsRow" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_layout" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/columns_label"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="7" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="8" />
            </LinearLayout>

            <TextView style="@style/SettingsHint" android:text="@string/hint_columns" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rows_below_dock_label"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
            </LinearLayout>

            <TextView android:id="@+id/hintRows" style="@style/SettingsHint" android:text="@string/hint_rows" />

            <TextView style="@style/SettingsSection" android:text="@string/section_look" />

            <TextView
                android:id="@+id/wallpaperChoice"
                style="@style/SettingsRow" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_wallpaper" />

            <TextView
                android:id="@+id/fontChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_font" />

            <TextView
                android:id="@+id/cinematicChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_cinematic" />

            <TextView
                android:id="@+id/namesChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_names" />

            <TextView style="@style/SettingsSection" android:text="@string/section_effects" />

            <TextView
                android:id="@+id/glowChoice"
                style="@style/SettingsRow" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_glow" />

            <TextView
                android:id="@+id/ambientChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_ambient" />

            <TextView
                android:id="@+id/animationsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_animations" />

            <TextView
                android:id="@+id/advancedChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/advanced_effects_warning" />

            <TextView style="@style/SettingsSection" android:text="@string/section_extras" />

            <TextView
                android:id="@+id/clockChoice"
                style="@style/SettingsRow" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_clock" />

            <TextView
                android:id="@+id/previewChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_preview" />

            <TextView
                android:id="@+id/perfChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView style="@style/SettingsHint" android:text="@string/hint_perf" />

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp"
                android:text="@string/follow_theme" />

            <TextView style="@style/SettingsHint" android:text="@string/follow_theme_hint" />

            <TextView style="@style/SettingsSection" android:text="@string/section_tv" />

            <TextView
                android:id="@+id/defaultHomeChoice"
                style="@style/SettingsRow"
                android:text="@string/home_settings" />

            <TextView style="@style/SettingsHint" android:text="@string/home_settings_help" />

            <TextView
                android:id="@+id/tvSettingsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp"
                android:text="@string/tv_settings" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
